# EditorConfig is awesome: https://EditorConfig.org

# Top-most EditorConfig file
root = true

# Default rules for all files
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Go files (Official Go convention: gofmt enforces tabs for indentation)
[*.go]
indent_style = tab
indent_size = 4
tab_width = 4
insert_final_newline = true

# Go module files
[go.{mod,sum}]
indent_style = tab
indent_size = 4
tab_width = 4

# JSON files
[*.json]
indent_style = space
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Markdown files
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# Shell and PowerShell scripts
[*.{sh,bash,zsh,ps1}]
indent_style = space
indent_size = 2

# Dockerfile
[Dockerfile*]
indent_style = space
indent_size = 2

# Makefiles
[Makefile*]
indent_style = tab
